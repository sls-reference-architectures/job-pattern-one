    "@faker-js/faker": "^10.1.0",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "async-retry": "^1.3.3",
    "aws4-axios": "^3.4.0",
    "axios": "^1.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "serverless": "^4.23.0",
    "serverless-deployment-bucket": "^1.6.0",
